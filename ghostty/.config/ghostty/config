## General
mouse-hide-while-typing = true
window-padding-balance = true
# window-decoration = false
unfocused-split-opacity = 0.2
fullscreen = true
auto-update = download

## Macos
macos-titlebar-proxy-icon = hidden
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = FFFFFF
macos-icon-screen-color = 000000

## Theme
theme = seti

## Background
background-opacity = 1
background-blur-radius = 20
split-divider-color = #314158

## Keybinds
# keybind = ctrl+z=close_surface
# keybind = ctrl+d=new_split:right
keybind =  cmd+s=toggle_quick_terminal

## Font
font-family = "MesloLGS Nerd Font Mono"
font-size = 14
font-thicken = false

# Redirect to Symbols Nerd Font for showing icon fonts in proper size
font-codepoint-map = U+E000-U+E00A,U+E0A0-U+E0A3,U+E0B0-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+EA60-U+EC1E,U+ED00-U+F2FF,U+EE00-U+EE0B,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=Symbols Nerd Font
## Clipboard
clipboard-read = "allow"
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

## Cursor
cursor-opacity = 0.6
cursor-style-blink = false
selection-background = #303233
selection-foreground = #cacecd

custom-shader = ./cursor-shaders/shaders/cursor_smear.glsl
custom-shader = ./cursor-shaders/shaders/cursor-style-blink.glsl
